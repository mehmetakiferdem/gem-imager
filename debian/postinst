#!/bin/sh

set -e

if [ ! -x /usr/bin/t3-gem-imager ]; then
    chmod +x /usr/bin/t3-gem-imager
fi

# Rules installed by the app in older versions: the 99- prefix defeated
# uaccess, and versions up to 1.1 were named gem-imager
rm -f /etc/udev/rules.d/99-gem-imager-dfu.rules
rm -f /etc/udev/rules.d/60-gem-imager-dfu.rules

if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=usb || true
fi

#DEBHELPER#
