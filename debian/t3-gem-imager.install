#!/usr/bin/dh-exec

t3-gem-imager.AppImage => /usr/bin/t3-gem-imager

debian/t3-gem-imager.png /usr/share/icons/hicolor/256x256/apps/

debian/*.desktop /usr/share/applications/
debian/*.metainfo.xml /usr/share/metainfo/
debian/*.policy /usr/share/polkit-1/actions/
src/linux/60-t3-gem-imager-dfu.rules => /usr/lib/udev/rules.d/60-t3-gem-imager-dfu.rules
