#include <windows.h>

IDI_ICON1 ICON DISCARDABLE "../icons/t3-gem-imager.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "t3-gem-imager.manifest"

1 VERSIONINFO
FILEVERSION IMAGER_VERSION_CSV
PRODUCTVERSION IMAGER_VERSION_CSV
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904b0"
        {
            VALUE "CompanyName",     "T3 Foundation"
            VALUE "FileDescription", "T3 Gemstone Imager"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1252
    }
}
